# QuickQuote — configurazione locale
# Copia in .env e inserisci i valori del tuo progetto. Non committare mai .env.

# Supabase — client/browser (solo chiave publishable, mai service role)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — solo server, mai prefisso VITE_
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=

# Stripe — token pubblico usato dalla build per selezionare sandbox o live
# Inserire qui il publishable key appropriato se la UI lo richiede.
VITE_PAYMENTS_CLIENT_TOKEN=

# URL pubblico definitivo (da configurare quando si sceglie il dominio)
SITE_URL=
